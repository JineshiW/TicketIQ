[Unit]
Description=TicketIQ FastAPI Backend
After=network.target ollama.service
Wants=ollama.service

[Service]
Type=simple

User=ticketiq
Group=ticketiq

WorkingDirectory=/opt/ticketiq/server

Environment="PATH=/opt/ticketiq/server/venv/bin:/usr/local/bin:/usr/bin"
Environment="QDRANT_PATH=/opt/ticketiq/server/qdrant_db"
Environment="OLLAMA_HOST=http://127.0.0.1:11434"
Environment="CORS_ORIGINS=https://client-lemon-xi-13.vercel.app"

ExecStart=/opt/ticketiq/server/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000

Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target